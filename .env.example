# ==============================================================================
# noaddress. Environment Configuration Example
# Copy to .env and adjust values or run 'make setup' to generate automatically.
# ==============================================================================

# Cryptographic Keys (Auto-generated by 'make setup')
JWT_SECRET=
JWT_SECRET_MIN_LEN=32
JWT_ISSUER=noaddress-backend
JWT_AUDIENCE=noaddress-web
JWT_EXPIRATION_MINUTES=15

MASTER_KEY_ACTIVE_ID=
MASTER_KEY_ACTIVE=
MASTER_KEY_OLD=
ACCOUNT_LOOKUP_PEPPER=

# Database Configuration
# DB_HOST: host address when running tests on host machine (e.g. localhost)
# DOCKER_DB_HOST: container service name inside docker compose network (postgres)
DB_HOST=localhost
DOCKER_DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=noaddress
DB_SSL_MODE=disable

# Application & Network Settings
APP_ENV=development
LOG_LEVEL=info
BACKEND_PORT=8080
ALLOWED_ORIGINS=http://localhost
TRUSTED_PROXIES=

# HTTP Payload and JSON Limits
MAX_REQUEST_BODY_BYTES=1048576
MAX_JSON_DEPTH=2

# Messaging, Invites and Retention
INVITE_TTL_SEC=86400
MAX_ACTIVE_INVITES=5
MAX_CONVERSATIONS_PER_USER=256
MAX_MESSAGE_BYTES=8192
MESSAGE_PAGE_LIMIT=200
MESSAGE_TTL_DAYS=7

# Proof of Work (Hashcash)
POW_DIFFICULTY=20
POW_CHALLENGE_TTL_SEC=300

# Argon2id Hashing Parameters
ARGON2_MEMORY_KIB=65536
ARGON2_TIME=3
ARGON2_PARALLELISM=2
ARGON2_SALT_LENGTH=16
ARGON2_HASH_LENGTH=32

# Pending Registration Store
PENDING_TOKEN_TTL_SEC=300
PENDING_CLEANUP_INTERVAL_SEC=60
PENDING_ID_BYTES=16
INTERNAL_ID_LENGTH=24

# Rate Limiting
RATE_LIMIT_MAX_TOKENS=20
RATE_LIMIT_REFILL_INTERVAL_SEC=3
RATE_LIMIT_CLEANUP_INTERVAL_SEC=300
RATE_LIMIT_MAX_BUCKETS=10000

# Server HTTP Timeouts
SERVER_READ_HEADER_TIMEOUT_SEC=5
SERVER_READ_TIMEOUT_SEC=15
SERVER_WRITE_TIMEOUT_SEC=15
SERVER_IDLE_TIMEOUT_SEC=60
SERVER_MAX_HEADER_BYTES=8192
